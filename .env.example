# Telegram Bot Token (получить у @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Telegram ID владельца группы
OWNER_TELEGRAM_ID=123456789

# Путь к файлу SQLite базы данных
DATABASE_PATH=./data/bot.db

# Часовой пояс группы
GROUP_TIMEZONE=Europe/Minsk

# Уровень логирования: debug, info, warn, error
LOG_LEVEL=info

# Публичный HTTPS URL для webhook
WEBHOOK_URL=https://your-domain.example.com

# Секретная строка в пути webhook
WEBHOOK_PATH_SECRET=change-me-to-random-string

# Секретный токен для заголовка X-Telegram-Bot-Api-Secret-Token
WEBHOOK_SECRET_TOKEN=change-me-to-another-random-string

# Внутренний адрес для HTTP-сервера
HTTP_LISTEN_ADDR=:8080

# Удалённая БД Turso/libSQL (оба значения обязательны для удалённого режима).
# При их заполнении DATABASE_PATH не используется.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# На Render задаётся платформой; применяется, если HTTP_LISTEN_ADDR пуст.
# PORT=10000
# WEBHOOK_URL может быть пуст на Render: используется RENDER_EXTERNAL_URL.
